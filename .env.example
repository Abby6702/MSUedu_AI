# Copy this file to ".env" and fill in YOUR values. Never commit ".env".
SECRET_KEY=replace-with-a-long-random-string

DB_HOST=localhost
DB_PORT=3306
DB_USER=msuedu_user
DB_PASSWORD=replace-with-your-database-password
DB_NAME=msuedu_ai

# Development only: show database status on the homepage
SHOW_SYSTEM_STATUS=true

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
# Use the exact name shown by:  ollama list
OLLAMA_MODEL=replace-with-your-installed-model-name
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=800

# Session reminders (hours before a session, comma separated)
REMINDERS_ENABLED=true
REMINDER_HOURS=24,1
REMINDER_CHECK_MINUTES=5

# Security (set SESSION_COOKIE_SECURE=true only when served over HTTPS)
SESSION_COOKIE_SECURE=false
CSP_ENABLED=true


# AI provider: "ollama" (local, default) or "openai" (online, OpenAI-compatible)
AI_PROVIDER=ollama
# Only needed when AI_PROVIDER=openai:
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

UPLOAD_FOLDER=uploads


# Live sessions (WebRTC). TURN is optional but needed for some networks.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=


   # Production only (see .env.production.example)
   SOCKETIO_ORIGINS=
   START_SCHEDULER=false