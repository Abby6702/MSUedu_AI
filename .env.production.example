# Production settings. Copy to ".env" ON THE SERVER, fill in your values, and never commit it.
# Then check it with:  flask --app run check-config
SECRET_KEY=replace-with-64-random-hex-characters
APP_DEBUG=false
SHOW_SYSTEM_STATUS=false
SESSION_COOKIE_SECURE=true
CSP_ENABLED=true
TRUST_PROXY=true
SOCKETIO_ORIGINS=https://replace-with-your-domain.example
START_SCHEDULER=true
REMINDERS_ENABLED=true

DB_HOST=localhost
DB_PORT=3306
DB_USER=replace-with-app-database-user
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=msuedu_ai

# Most cloud hosts cannot run Ollama, so use an online provider (or a private machine that runs Ollama)
AI_PROVIDER=openai
AI_BASE_URL=https://replace-with-your-provider/v1
AI_API_KEY=
AI_MODEL=

# Live video across networks usually needs a TURN relay
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# A folder on a PERSISTENT disk, outside the code folder
UPLOAD_FOLDER=/var/lib/msuedu/uploads